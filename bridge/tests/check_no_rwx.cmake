find_program(READELF readelf)
if(NOT READELF)
    message(FATAL_ERROR "readelf is required for ELF W^X checks")
endif()
execute_process(COMMAND "${READELF}" -lW "${PROGRAM}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "readelf failed: ${error}")
endif()
if(output MATCHES "LOAD[^\n]*RWE" OR output MATCHES "GNU_STACK[^\n]*RWE")
    message(FATAL_ERROR "ELF contains an RWX load segment or executable stack")
endif()
message(STATUS "ELF program headers contain no RWX load segment or executable stack")
